        <object placeholders="1" c4Name="ClickHouse (OLAP)" c4Type="Container" c4Technology="ClickHouse" c4Description="Аналитическая БД.&#xa;Таблица report_mart: витрина отчётности с данными телеметрии, сгруппированными по user_id.&#xa;Таблица etl_metadata: last_processed_date для контроля актуальности" label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%:&amp;nbsp;%c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="Ft3y8pqPBS80hK2BIdGr-245">
