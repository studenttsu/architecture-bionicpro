          </mxCell>
        </object>
        <object placeholders="1" c4Name="Apache Airflow" c4Type="Container" c4Technology="Airflow" c4Description="Apache Airflow&#xa;[Container: Airflow]&#xa;&#xa;ETL-оркестратор. DAG запускается по расписанию (ежедневно).&#xa;1. Извлекает данные из CRM и Telemetry DB&#xa;2. Трансформирует и объединяет&#xa;3. Загружает в ClickHouse витрину report_mart&#xa;4. Обновляет метку last_processed_date" label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="Ft3y8pqPBS80hK2BIdGr-246">
