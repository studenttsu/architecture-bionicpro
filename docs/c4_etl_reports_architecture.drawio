        <object placeholders="1" c4Name="Reports API" c4Type="Container" c4Technology="Python/FastAPI" c4Description="Эндпоинт GET /reports. Валидирует JWT, извлекает user_id из sub. Запрашивает данные из ClickHouse витрины. Возвращает отчёт только за обработанный Airflow период" label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="Ft3y8pqPBS80hK2BIdGr-239">
