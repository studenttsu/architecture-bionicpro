        <object placeholders="1" c4Name="Frontend SPA" c4Type="Container" c4Technology="React/TypeScript" c4Description="Веб-приложение для пользователей. Инициирует PKCE Code Grant flow. Не хранит и не получает токены от IdP напрямую." label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="Ft3y8pqPBS80hK2BIdGr-273">
