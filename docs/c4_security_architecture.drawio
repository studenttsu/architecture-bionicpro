            <mxGeometry height="150" width="280" x="782" y="833" as="geometry" />
          </mxCell>
        </object>
        <object placeholders="1" c4Name="Keycloak" c4Type="Container" c4Technology="Identity Provider" c4Description="Локальный IdP. Поддерживает PKCE Code Grant, Identity Brokering для внешних IdP разных стран. Хранит только ссылки на внешние учётные записи, НЕ персональные данные." label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="Ft3y8pqPBS80hK2BIdGr-275">
